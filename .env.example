# Copy this file to .env and fill in the values. Never commit .env.

# ---- Nexconn (from Console > Key Management: https://console.nexconn.ai/agile/apps/km)
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Data center of your app. One of: SG | NA | SA
# Must match the region shown on the Key Management page.
NEXCONN_AREA_CODE=SG

# ---- Aangan
# ID of the single hard-coded family group (letters and digits only, max 64).
# The server creates it on first login if it does not exist yet.
AANGAN_FAMILY_CHANNEL_ID=aanganfamily
AANGAN_FAMILY_CHANNEL_NAME=Aangan Family

# ---- Server
PORT=3001
