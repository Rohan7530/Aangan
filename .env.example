# Copy this file to .env and fill in the values. Never commit .env.

# ---- Nexconn (from Console > Key Management: https://console.nexconn.ai/agile/apps/km)
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Data center of your app. One of: SG | NA | SA
# Must match the region shown on the Key Management page.
NEXCONN_AREA_CODE=SG

# ---- Aangan
# ID of the single hard-coded family group (letters and digits only, max 64).
# The server creates it on first login if it does not exist yet.
AANGAN_FAMILY_CHANNEL_ID=aanganhome1
AANGAN_FAMILY_CHANNEL_NAME=Aangan Family
# Showcase/demo rooms (seeded once by the server). Change it to start a fresh demo.
AANGAN_DEMO_CHANNEL_ID=aangandemo2
# Separate room for automated tests (npm run dev:test). Must differ from the family ID.
AANGAN_TEST_CHANNEL_ID=aangantest1

# ---- Translation (optional "llm" engine; leave TRANSLATE_API_KEY empty to use only
# Nexconn's built-in translation). The key stays on the server.
TRANSLATE_PROVIDER=gemini
TRANSLATE_API_KEY=
# Optional overrides:
# TRANSLATE_MODEL=gemini-3.8-flash
# TRANSLATE_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite

# ---- Server
PORT=3001

# Sarvam AI (dashboard.sarvam.ai). With TRANSLATE_PROVIDER=sarvam this key is used first,
# and TRANSLATE_API_KEY (Gemini) becomes the automatic backup.
SARVAM_API_KEY=
